# =============================================================================
# M&M Auto Performance — local environment template
# =============================================================================
# Copy this file to `.env.local` (which is gitignored and NEVER committed):
#     cp .env.example .env.local
# then paste your real keys where marked "PASTE …".
#
# Public values (NEXT_PUBLIC_* + the Supabase URL) are safe to keep as-is.
# Secret values live in your Supabase / Stripe / Google dashboards — grab them
# once, paste into .env.local, and you can run the whole site locally for free.
# =============================================================================

# ---- Supabase (database, auth, storage) -------------------------------------
# URL + anon key are PUBLIC (they ship in the browser). URL is pre-filled.
NEXT_PUBLIC_SUPABASE_URL=https://ratyazffxlppzurfokxp.supabase.co
# Dashboard -> Project Settings -> API -> "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_PUBLIC_KEY
# Dashboard -> Project Settings -> API -> "service_role"  (SECRET - server only)
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY

# ---- Google Gemini (MIA concierge + War Room scout) -------------------------
# aistudio.google.com/app/apikey  (SECRET - server only, no NEXT_PUBLIC_)
GEMINI_API_KEY=PASTE_GEMINI_KEY
# Optional override; leave blank to use the default (gemini-2.5-flash)
GEMINI_MODEL=

# ---- Stripe (payments) ------------------------------------------------------
# Use your TEST keys locally (sk_test_... / whsec_...) so no real money moves.
STRIPE_SECRET_KEY=sk_test_PASTE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_PASTE_TEST_WEBHOOK_SECRET

# ---- Email (optional locally - flows still work without it) -----------------
# resend.com/api-keys. Without it, notification emails are just skipped.
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=mandmautoperformance@gmail.com

# ---- Access control ---------------------------------------------------------
# The owner is already hard-coded in lib/auth-middleware.ts; this only ADDS
# extra admins. War Room owner is likewise pinned in code.
ADMIN_EMAILS=
WAR_ROOM_OWNER_EMAIL=mahdikermanii@outlook.com

# ---- Local site URL ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional ---------------------------------------------------------------
# DVLA licence-check API (only if you wire up live licence verification)
DVLA_API_KEY=
